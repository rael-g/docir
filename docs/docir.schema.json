{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docir document, format 2",
  "$ref": "#/$defs/Document",
  "$defs": {
    "Document": {
      "type": "object",
      "properties": {
        "format": {
          "type": "integer",
          "minimum": 0
        },
        "linked": {
          "type": "boolean"
        },
        "source_root": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/File"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Symbol"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "File": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "documented": {
          "type": "boolean"
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Import"
          }
        }
      },
      "required": [
        "path",
        "language"
      ],
      "additionalProperties": false
    },
    "Import": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ImportKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "ImportKind": {
      "enum": [
        "file",
        "module",
        "include"
      ]
    },
    "Symbol": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "qualified_name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "form": {
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "signature": {
          "type": "string"
        },
        "doc": {
          "$ref": "#/$defs/Text"
        },
        "inherits": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "type_params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeParam"
          }
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Param"
          }
        },
        "type": {
          "$ref": "#/$defs/TypeRef"
        },
        "returns": {
          "$ref": "#/$defs/Text"
        },
        "raises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Raised"
          }
        },
        "bases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeRef"
          }
        },
        "value": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Example"
          }
        },
        "verified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Symbol"
          }
        }
      },
      "required": [
        "id",
        "name",
        "qualified_name",
        "kind"
      ],
      "additionalProperties": false
    },
    "Kind": {
      "enum": [
        "namespace",
        "module",
        "type",
        "function",
        "field",
        "property",
        "event",
        "constant",
        "variable",
        "enumerator",
        "alias",
        "macro"
      ]
    },
    "Visibility": {
      "enum": [
        "public",
        "protected",
        "internal",
        "private"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "Text": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "paragraph": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Inline"
              }
            }
          },
          "required": [
            "paragraph"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "heading": {
              "$ref": "#/$defs/Heading"
            }
          },
          "required": [
            "heading"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/Code"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "list": {
              "$ref": "#/$defs/List"
            }
          },
          "required": [
            "list"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quote": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Block"
              }
            }
          },
          "required": [
            "quote"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "note": {
              "$ref": "#/$defs/Note"
            }
          },
          "required": [
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "table": {
              "$ref": "#/$defs/Table"
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rule": {
              "type": "object",
              "maxProperties": 0
            }
          },
          "required": [
            "rule"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Inline": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/Ref"
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "param": {
              "type": "string"
            }
          },
          "required": [
            "param"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "emphasis": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Inline"
              }
            }
          },
          "required": [
            "emphasis"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "strong": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Inline"
              }
            }
          },
          "required": [
            "strong"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "link": {
              "$ref": "#/$defs/Link"
            }
          },
          "required": [
            "link"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/$defs/Link"
            }
          },
          "required": [
            "image"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "line_break": {
              "type": "object",
              "maxProperties": 0
            }
          },
          "required": [
            "line_break"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Ref": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Inline"
          }
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "Heading": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Inline"
          }
        }
      },
      "required": [
        "level",
        "content"
      ],
      "additionalProperties": false
    },
    "Code": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "List": {
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Block"
            }
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "Note": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "required": [
        "label",
        "blocks"
      ],
      "additionalProperties": false
    },
    "Table": {
      "type": "object",
      "properties": {
        "header": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Inline"
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Inline"
              }
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "TypeParam": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "constraint": {
          "type": "string"
        },
        "doc": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Param": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TypeRef"
        },
        "doc": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "TypeRef": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Raised": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/TypeRef"
        },
        "doc": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Example": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    }
  }
}
